#!/usr/bin/env bash
# Set (or restore) the desktop background via swaybg.
# Usage: hypr-bg-set [path-to-image]
#   With no argument, restores the last-set background (or a default).
set -euo pipefail

STATE_DIR="$HOME/.local/state/hypr"
CURRENT_LINK="$STATE_DIR/current-background"
DEFAULT_BG="$HOME/Pictures/Wallpapers/archDefault.png"

mkdir -p "$STATE_DIR"

if [[ $# -ge 1 ]]; then
    BACKGROUND="$(realpath "$1")"
    if [[ ! -f "$BACKGROUND" ]]; then
        echo "File does not exist: $BACKGROUND" >&2
        exit 1
    fi
    ln -nsf "$BACKGROUND" "$CURRENT_LINK"
else
    if [[ -L "$CURRENT_LINK" && -f "$CURRENT_LINK" ]]; then
        BACKGROUND="$(readlink -f "$CURRENT_LINK")"
    else
        BACKGROUND="$DEFAULT_BG"
        ln -nsf "$BACKGROUND" "$CURRENT_LINK"
    fi
fi

pkill -x swaybg 2>/dev/null || true
setsid swaybg -i "$BACKGROUND" -m fill >/dev/null 2>&1 &
disown
